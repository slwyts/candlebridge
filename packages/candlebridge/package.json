{
  "name": "candlebridge",
  "version": "0.1.0",
  "description": "Deterministic, endpoint-locked stochastic OHLC candlestick generator with regime switching, volatility memory, Student-t fat tails, jumps, and cross-timeframe path consistency.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "candlestick",
    "kline",
    "ohlc",
    "synthetic-data",
    "stochastic",
    "brownian-bridge",
    "quant",
    "backtesting",
    "trading",
    "finance"
  ],
  "sideEffects": [
    "./dist/worker.js",
    "./dist/worker.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./worker": {
      "import": {
        "types": "./dist/worker.d.ts",
        "default": "./dist/worker.js"
      },
      "require": {
        "types": "./dist/worker.d.cts",
        "default": "./dist/worker.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
