{
  "name": "candlebridge-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "npm run build:playground",
    "build:lib": "npm run build --workspace=candlebridge",
    "build:playground": "npm run build:lib && npm run build --workspace=@candlebridge/playground",
    "predev": "npm run build:lib",
    "dev": "npm run dev --workspace=@candlebridge/playground",
    "test": "npm run test --workspace=candlebridge",
    "typecheck": "npm run typecheck --workspace=candlebridge && npm run typecheck --workspace=@candlebridge/playground",
    "test:browser": "playwright test",
    "test:package": "node scripts/test-package.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preview": "npm run preview --workspace=@candlebridge/playground"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@playwright/test": "^1.65.1",
    "prettier": "^3.6.2",
    "tsup": "^9.0.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12"
  }
}
